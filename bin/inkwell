#!/bin/sh
# Run inkwell from a checkout, from any directory, installing nothing.
# Follows symlinks so this can live on $PATH (e.g. ~/.local/bin/inkwell).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname -- "$self")/$link ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m inkwell "$@"
